# --- mescc additions (SUB_SP_SP_X14 already provided by the seed above) ---
DEFINE SET_X0_FROM_X9 e00309aa  # mov x0, x9 (mescc r0 -> C return register)
# 64-bit literal-pool loads (ldr x<n>, [pc+8]) used by value_address /
# label_address; the M2 path only needs the 32-bit w-loads above.
DEFINE LOAD_X9_AHEAD 49000058   # ldr x9,  8
DEFINE LOAD_X10_AHEAD 4a000058  # ldr x10, 8
DEFINE LOAD_X11_AHEAD 4b000058  # ldr x11, 8
DEFINE LOAD_X12_AHEAD 4c000058  # ldr x12, 8
DEFINE LOAD_X13_AHEAD 4d000058  # ldr x13, 8
DEFINE LOAD_X14_AHEAD 4e000058  # ldr x14, 8
DEFINE LOAD_X15_AHEAD 4f000058  # ldr x15, 8 (condregy literal loads)
DEFINE LOAD_X16_AHEAD 50000058  # ldr x16, 8 (scratch / frame-size / arg-addr loads)
DEFINE SKIP_64_DATA 03000014    # b .+12 (skip the 8-byte literal)
DEFINE nop d503201f             # inline asm ("nop") token (cf. 08-assign.c)

# --- mescc libc / crt1 additions ---
# Positive add-immediates to x0, the deref scratch.  The libc syscall
# wrappers read positional args at [BP+16], [BP+24], ... (mescc places
# arg N above the frame, like riscv64; cf. lib/linux/*-mes-mescc); the
# idiom is SET_X0_FROM_BP / ADD_X0_<off> / DEREF_X0.
DEFINE ADD_X0_8 00200091        # add x0, x0, #8
DEFINE ADD_X0_16 00400091       # add x0, x0, #16
DEFINE ADD_X0_24 00600091       # add x0, x0, #24
DEFINE ADD_X0_32 00800091       # add x0, x0, #32
DEFINE ADD_X0_40 00a00091       # add x0, x0, #40
DEFINE ADD_X0_48 00c00091       # add x0, x0, #48
DEFINE ADD_X0_56 00e00091       # add x0, x0, #56
DEFINE SET_X9_FROM_X0 e90300aa  # mov x9, x0  (syscall return -> mescc r0)
DEFINE SET_SP_FROM_X0 f20300aa  # mov x18, x0 (longjmp: restore SP)
DEFINE SET_BP_FROM_X0 f10300aa  # mov x17, x0 (longjmp: restore BP)
