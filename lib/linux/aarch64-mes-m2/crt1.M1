;; aarch64 entry trampoline for mes-on-Linux.
;;
;; Layout assumptions:
;;   - Linux kernel hands us:
;;       sp -> argc
;;       sp + 8 -> argv[0]
;;       sp + (argc+1)*8 -> NULL
;;       sp + (argc+2)*8 -> envp[0]
;;
;;   - We capture sp into x18 (INIT_SP) and use x18 as the simulated
;;     stack from here on. PUSH_X* / POP_X* operate on x18 ([x18,#-8]!
;;     and [x18],8). BP (x17) becomes the frame pointer.
;;
;;   - M2-Planet expects function args at [BP - 8*N] for the Nth
;;     positional arg. main(argc, argv, envp) reads:
;;       argc at [BP-8], argv at [BP-16], envp at [BP-24].
;;
;; Strategy:
;;   1. INIT_SP, then load argc and compute argv before any PUSH (PUSH
;;      mutates x18, after which LDR_X0_[SP] no longer means "argc").
;;   2. Set BP = x18 (original kernel sp). Now BP-8 = address of argc,
;;      BP-16 will be argv (after first push), etc.
;;   3. Push argc, argv, envp in order (M2-Planet ABI: args pushed
;;      in declaration order).
;;   4. Call __init_io (mes libc init for stdin/stdout/stderr).
;;   5. Call main. Return code lands in x0.
;;   6. Pop the 3 args we pushed, push x0 three times so the
;;      common :FUNCTION_exit / :FUNCTION__exit tail can pull
;;      the exit code from BP-8 and SVC.
;;
;; This shape mirrors M2libc/aarch64/libc-core.M1 with one addition
;; (the __init_io call). __init_malloc is intentionally omitted --
;; mes manages its own heap.

:_start
	INIT_SP
	LDR_X0_[SP]
	ADD_X1_SP_8
	SET_BP_FROM_SP
	PUSH_X0
	PUSH_X1
	SET_X1_TO_2
	ADD_X0_X1_X0
	SET_X1_TO_8
	MUL_X0_X1_X0
	ADD_X0_BP_X0
	PUSH_X0

	;; Init libc (sets __stdin/__stdout/__stderr from fd 0/1/2)
	LOAD_W16_AHEAD
	SKIP_32_DATA
	&FUNCTION___init_io
	BLR_X16

	;; Call main(argc, argv, envp); args were placed at BP-8/-16/-24
	;; by the three PUSH_X0/PUSH_X1/PUSH_X0 sequence above.
	LOAD_W16_AHEAD
	SKIP_32_DATA
	&FUNCTION_main
	BLR_X16

	;; main's return code is in x0. Replace argc/argv/envp on the
	;; stack with the return code (3 copies) so that FUNCTION_exit
	;; / FUNCTION__exit pulls the exit status from BP-8.
	POP_X1
	POP_X1
	POP_X1
	PUSH_X0
	PUSH_X0
	PUSH_X0

:FUNCTION_exit
:FUNCTION__exit
	SET_X0_FROM_BP
	SUB_X0_8
	DEREF_X0
	SET_X8_TO_SYS_EXIT
	SYSCALL
