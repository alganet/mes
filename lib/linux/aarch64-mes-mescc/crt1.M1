;; aarch64 mescc entry point.
;;
;; mescc uses x18 as its software stack pointer, but the Linux kernel
;; hands control with the *hardware* sp set up and x18 undefined.  And
;; mescc emits the function preamble (PUSH_LR/PUSH_BP, storing through
;; x18) unconditionally before a function's first statement -- so a
;; crt1.c _start like the other targets use would fault before it could
;; INIT_SP.  Hence aarch64 ships hand-written startup assembly.
;;
;; BUILD NOTE: build-aux/build-lib.sh compiles crt1.c into crt1.o for
;; every other target; for aarch64 it assembles THIS file instead:
;;   M1 --little-endian --architecture aarch64 \
;;      -f lib/aarch64-mes/aarch64.M1 -f crt1.M1 -o crt1.o
;;
;; Kernel stack at entry (hardware sp):
;;   [sp]            argc
;;   [sp+8]          argv[0] ...  [sp+8+8*argc] NULL
;;   [sp+8*(argc+2)] envp[0] ...
;;
;; mescc passes positional args ABOVE the callee frame, so to call
;; main(argc, argv, envp) / __init_io(argc, argv, envp) we push the
;; three values in reverse (envp, argv, argc) so argc ends up on top;
;; after the callee's PUSH_LR/PUSH_BP they sit at [BP+16]/[+24]/[+32].
;; The same three pushed words serve both calls (neither callee pops
;; its args -- mescc's caller does, and here that caller is us).
;;
;; "<" pads to a 4-byte boundary: aarch64 fetches instructions aligned,
;; and the linker may place _start right after an odd-length string
;; literal (mescc emits compiled functions with this same align prefix,
;; but hand-written _start would otherwise inherit whatever offset it
;; lands on -> unaligned entry -> SIGILL on the first fetch).
<
:_start
	INIT_SP                 ; x18 = kernel sp; BP base for the arg math
	SET_BP_FROM_SP          ; x17 = kernel sp ([BP]=argc, [BP+8]=argv[0])

	;; push envp = BP + 8*(argc+2)
	LDR_X0_[SP]             ; x0 = argc            (x18 still = kernel sp)
	SET_X1_TO_2
	ADD_X0_X1_X0            ; x0 = argc + 2
	SET_X1_TO_8
	MUL_X0_X1_X0            ; x0 = 8*(argc+2)
	ADD_X0_BP_X0            ; x0 = &envp[0]
	PUSH_X0

	;; push argv = BP + 8
	SET_X0_FROM_BP
	ADD_X0_8                ; x0 = &argv[0]
	PUSH_X0

	;; push argc = [BP]
	SET_X0_FROM_BP
	DEREF_X0                ; x0 = argc
	PUSH_X0

	;; __init_io (argc, argv, envp): sets __stdin/__stdout/__stderr,
	;; environ
	LOAD_W16_AHEAD
	SKIP_32_DATA
	&__init_io
	BLR_X16

	;; main (argc, argv, envp): same three args still on the stack
	LOAD_W16_AHEAD
	SKIP_32_DATA
	&main
	BLR_X16

	;; exit (main): mescc leaves the return value in r0 = x9
	SET_X0_FROM_X9
	SET_X8_TO_SYS_EXIT
	SYSCALL
