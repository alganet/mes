;; Minimal aarch64 mescc entry trampoline (first-green-test scaffold).
;;
;; mescc uses x18 as its software stack pointer, but the Linux kernel
;; hands control with the *hardware* sp set up and x18 undefined. So we
;; must INIT_SP (x18 = sp) before main's compiled preamble does any
;; PUSH (which stores through x18). A mescc-compiled C _start cannot do
;; this -- mescc emits the function preamble (PUSH_LR/PUSH_BP, which
;; store through x18) unconditionally, before the first statement -- so
;; unlike the other targets, aarch64 ships hand-written startup assembly
;; instead of a crt1.c.
;;
;; BUILD NOTE: build-aux/build-lib.sh compiles crt1.c into crt1.o for
;; every other target.  For aarch64 it must instead assemble THIS file:
;;   M1 --little-endian --architecture aarch64 \
;;      -f lib/aarch64-mes/aarch64.M1 -f crt1.M1 -o crt1.o
;; That wiring lands with the configure --host=aarch64 / libc step; until
;; then this file is consumed only by the local mescc test harness.
;;
;; main() here takes no positional args; mescc leaves its return value
;; in r0 = x9 (the first IR register), which we move to x0 for exit().
;; argc/argv push + __init_io are added once libc lands.

:_start
	INIT_SP
	LOAD_W16_AHEAD
	SKIP_32_DATA
	&main
	BLR_X16
	SET_X0_FROM_X9
	SET_X8_TO_SYS_EXIT
	SYSCALL
