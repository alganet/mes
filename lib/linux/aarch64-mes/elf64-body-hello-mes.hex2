### Commentary:

# elf64-body-hello-mes.hex2: `Hello, GNU Mes!' for aarch64-linux written
# in hex2 assembly, for usage with generic elf64-header.hex2 and
# elf64-footer-single-main.hex2.

# This ELF binary contains a symbol table which means that objdump and
# gdb can be used to inspect and debug.

### Code:

# @300
:ELF_text
:_start
                     # call main
70 00 00 10          # adr x16, #12  (pc + 12 -> &main literal)
10 02 40 b9          # ldr w16, [x16]
00 02 1f d6          # br  x16
&main                # 4-byte absolute address of main

# @310
:main
                     # write (1, hello, 16)
08 08 80 d2          # mov x8, #64   (SYS_write)
20 00 80 d2          # mov x0, #1    (stdout)
41 02 00 10          # adr x1, hello (pc + 0x48)
02 02 80 d2          # mov x2, #16
01 00 00 d4          # svc #0
                     # exit (0)
a8 0b 80 d2          # mov x8, #93   (SYS_exit)
00 00 80 d2          # mov x0, #0
01 00 00 d4          # svc #0
00 00 20 d4          # brk #0        (not reached)

00 00 00 00 00 00 00 00 00 00 00 00     # align to @360 (44 bytes)
00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00

# @360
:ELF_data
:hello
48 65 6c 6c 6f 2c 20 47        # Hello, G
4e 55 20 4d 65 73 21 0a        # NU Mes!\n
:bye
:ELF_end
